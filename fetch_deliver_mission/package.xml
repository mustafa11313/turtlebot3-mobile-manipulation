<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fetch_deliver_mission</name>
  <version>0.1.0</version>
  <description>Behaviour-tree mission (search, approach, align, pick, deliver, place, return), visual-servo alignment and frontier exploration.</description>
  <maintainer email="mustafaalmohammad123@gmail.com">Mustafa Almohamad</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>py_trees</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>fetch_deliver_interfaces</exec_depend>
  <exec_depend>fetch_deliver_gazebo</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
